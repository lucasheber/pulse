# Pulse — Docker Compose Environment
APP_ENV=dev

# MySQL (1 container, 3 isolated databases: bff_db, finance_db, planner_db)
MYSQL_ROOT_PASSWORD=pulse_root_secret
MYSQL_USER=pulse
MYSQL_PASSWORD=pulse_secret
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=pulse
RABBITMQ_PASSWORD=pulse_secret
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Service Ports (Host)
BFF_PORT=9501
FINANCE_PORT=9502
PLANNER_PORT=9503
FRONTEND_PORT=5173

# Security (change in any non-local environment)
JWT_SECRET=change-me-to-a-long-random-secret-key-min-32-chars

# Code Quality (SonarQube - optional profile: "quality")
SONARQUBE_PORT=9000
SONAR_TOKEN=
