APP_NAME=planner-service
APP_ENV=dev
SCAN_CACHEABLE=false

DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=planner_db
DB_USERNAME=pulse
DB_PASSWORD=pulse_secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=
REDIS_DB=2

AMQP_HOST=rabbitmq
AMQP_PORT=5672
AMQP_USER=pulse
AMQP_PASSWORD=pulse_secret
AMQP_VHOST=/
