APP_NAME=bff-gateway
APP_ENV=dev
SCAN_CACHEABLE=false

DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bff_db
DB_USERNAME=pulse
DB_PASSWORD=pulse_secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=
REDIS_DB=0

AMQP_HOST=rabbitmq
AMQP_PORT=5672
AMQP_USER=pulse
AMQP_PASSWORD=pulse_secret
AMQP_VHOST=/

JWT_SECRET=change-me-to-a-long-random-secret-key-min-32-chars
FINANCE_SERVICE_URL=http://finance-service:9501
PLANNER_SERVICE_URL=http://planner-service:9501
CORS_ALLOWED_ORIGIN=http://localhost:5173
