{
  "name": "pulse/bff-gateway",
  "type": "project",
  "description": "Pulse BFF & API Gateway (Hyperf 3)",
  "license": "proprietary",
  "require": {
    "php": ">=8.5",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-redis": "*",
    "ext-swoole": ">=6.2",
    "firebase/php-jwt": "^7.0",
    "hyperf/amqp": "~3.2.0",
    "hyperf/cache": "~3.2.0",
    "hyperf/command": "~3.2.0",
    "hyperf/config": "~3.2.0",
    "hyperf/database": "~3.2.0",
    "hyperf/db-connection": "~3.2.0",
    "hyperf/di": "~3.2.0",
    "hyperf/framework": "~3.2.0",
    "hyperf/guzzle": "~3.2.0",
    "hyperf/http-server": "~3.2.0",
    "hyperf/logger": "~3.2.0",
    "hyperf/memory": "~3.2.0",
    "hyperf/process": "~3.2.0",
    "hyperf/redis": "~3.2.0",
    "hyperf/validation": "~3.2.0",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "hyperf/devtool": "~3.2.0",
    "hyperf/testing": "~3.2.0",
    "hyperf/watcher": "~3.2.0",
    "phpstan/phpstan": "^2.1",
    "swoole/ide-helper": "^6.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HyperfTest\\": "test/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "test": "co-phpunit --prepend test/bootstrap.php -c phpunit.xml --colors=always",
    "cs-fix": "php-cs-fixer fix $1",
    "analyse": "phpstan analyse --memory-limit 512M -l 5 ./app ./config"
  }
}
